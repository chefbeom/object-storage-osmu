  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "osmuAccessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OSMU-Access-Key"
      },
      "awsSigV4": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "AWS Signature Version 4 authorization header or equivalent presigned query parameters."
      }
    },
    "parameters": {
      "BucketName": {
        "name": "bucketName",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" }
      },
      "ObjectKey": {
        "name": "objectKey",
        "in": "path",
        "required": true,
        "description": "Slash-containing object keys are supported by Spring wildcard routes.",
        "schema": { "type": "string", "minLength": 1 }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "OrganizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PermissionId": {
        "name": "permissionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "KeyId": {
        "name": "keyId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "VersionId": {
        "name": "versionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "RuleId": {
        "name": "ruleId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "PrefixQuery": {
        "name": "prefix",
        "in": "query",
        "schema": { "type": "string" }
      },
      "SearchQuery": {
        "name": "search",
        "in": "query",
        "schema": { "type": "string" }
      },
      "TagQuery": {
        "name": "tag",
        "in": "query",
        "schema": { "type": "string" }
      },
      "DeletedQuery": {
        "name": "deleted",
        "in": "query",
        "schema": { "type": "boolean" }
      },
      "LimitQuery": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "CursorQuery": {
        "name": "cursor",
        "in": "query",
        "schema": { "type": "string" }
      }
    },
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      },
      "XmlOnly": {
        "required": true,
        "content": {
          "application/xml": {
            "schema": { "type": "string" }
          },
          "text/xml": {
            "schema": { "type": "string" }
          }
        }
      },
      "XmlOrJson": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          },
          "application/xml": {
            "schema": { "type": "string" }
          },
          "text/xml": {
            "schema": { "type": "string" }
          }
        }
      }
    },
    "responses": {
      "JsonOk": {
        "description": "JSON response",
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      },
      "JsonList": {
        "description": "JSON list response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ListResponse" }
          }
        }
      },
      "XmlOk": {
        "description": "XML response",
        "content": {
          "application/xml": {
            "schema": { "type": "string" }
          },
          "text/xml": {
            "schema": { "type": "string" }
          }
        }
      },
      "BinaryOk": {
        "description": "Binary response",
        "content": {
          "application/octet-stream": {
            "schema": { "type": "string", "format": "binary" }
          }
        }
      },
      "Error": {
        "description": "OSMU JSON error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "S3Error": {
        "description": "S3 XML error response",
        "content": {
          "application/xml": {
            "schema": { "type": "string" }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["loginId", "password"],
        "properties": {
          "loginId": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "CreateBucketRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "ownerType": { "type": "string", "enum": ["USER", "ORG"] },
          "ownerId": { "type": "string" },
          "quotaBytes": { "type": "integer", "format": "int64", "minimum": 0 },
          "visibility": { "type": "string", "default": "PRIVATE" }
        }
      },
      "ListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "nextCursor": { "type": "string", "nullable": true }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        }
      }
    }
  }
}
