{
  "name": "osmu-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "node --test \"src/**/*.test.js\"",
    "test:e2e": "playwright test ./e2e/lightweight-demo.spec.js --browser=chromium --reporter=line",
    "mock:api": "node ./mock-api/server.mjs",
    "mock:api:self-test": "node ./mock-api/server.mjs --self-test",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "prettier": "3.8.3",
    "vite": "^8.0.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
